# Local Compose configuration. Copy to .env and replace the Grafana password.
LOG_LEVEL=INFO
FAILURE_SIMULATION_ENABLED=false

# Internal Compose service addresses (Compose also configures these explicitly)
VEHICLE_SERVICE_URL=http://vehicle-service:8000
TELEMETRY_SERVICE_URL=http://telemetry-service:8000
ALERT_SERVICE_URL=http://alert-service:8000

# Host-published API ports (bound to 127.0.0.1)
VEHICLE_PORT=8001
TELEMETRY_PORT=8002
ALERT_PORT=8003

# Local Grafana login; set a unique password before starting Compose.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-this-with-a-long-random-password

# Dependency settings
SERVICE_TIMEOUT_SECONDS=2
BATTERY_TEMPERATURE_THRESHOLD=50
RPM_THRESHOLD=5000
SPEED_THRESHOLD=140

# Observability host ports
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
